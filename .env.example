# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://codeforge:password@db:5432/codeforge

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Sandbox Defaults ──────────────────────────────────────────────────────────
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_DEFAULT_TIMEOUT=10
SANDBOX_TMPFS_SIZE=16m
SANDBOX_PIDS_LIMIT=64
SANDBOX_ULIMIT_NOFILE=64

# ── Docker ────────────────────────────────────────────────────────────────────
DOCKER_HOST=unix:///var/run/docker.sock

# ── AI Tutor (Free tier available at https://aistudio.google.com) ─────────────
GEMINI_API_KEY=
